+    /**
+     * Whether the entity still has a persisted version scheduled in the update being edited.
+     *
+     * A stale browser tab can submit an update whose scheduled version was already removed in another
+     * session. The submitted created_in cannot be trusted (it comes from the stale form), so the
+     * persisted version rows are checked instead; re-scheduling a removed version corrupts the chain.
+     *
+     * @param mixed $entity
+     * @param int|string $updateId
+     * @return bool
+     */
+    private function isEntityScheduledInUpdate($entity, $updateId): bool
+    {
+        if (!$entity instanceof AbstractModel) {
+            return true;
+        }
+        $metadata = $this->metadataPool->getMetadata($this->typeResolver->resolve($entity));
+        $identifierField = $metadata->getIdentifierField();
+        $identifier = $entity->getData($identifierField);
+        if (empty($identifier)) {
+            return true;
+        }
+        $connection = $metadata->getEntityConnection();
+        $select = $connection->select()
+            ->from($metadata->getEntityTable(), [$identifierField])
+            ->where($identifierField . ' = ?', $identifier)
+            ->where('created_in = ?', $updateId)
+            ->setPart('disable_staging_preview', true);
+
+        return (bool)$connection->fetchOne($select);
+    }
+
