+        $this->entityStaging->expects($this->never())->method('schedule');
+
+        $this->expectException(LocalizedException::class);
+        $this->expectExceptionMessage('This scheduled update no longer exists. Reload the page and try again.');
+        $this->saveAction->execute($params);
+    }
+
