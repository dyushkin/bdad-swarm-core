+    {
+        $updateId = 100;
+        $params = [
+            'stagingData' => ['update_id' => $updateId, 'start_time' => 1],
+            'entityData' => [],
+        ];
+
+        $entityMock = $this->setUpEditScenario($updateId, false);
+        $this->entityHydrator->method('hydrate')->willReturn($entityMock);
