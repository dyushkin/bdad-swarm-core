+namespace Magento\SalesRuleStaging;
+
+use Magento\Framework\App\Request\Http;
+use Magento\Framework\App\ResourceConnection;
+use Magento\Framework\DB\Adapter\AdapterInterface;
+use Magento\SalesRule\Model\Rule;
