+                               stepKey="assertWaitForGridControls"/>
+        <actionGroup ref="AdminOpenCartPriceRulesPageActionGroup" stepKey="assertOpenGrid"/>
+        <conditionalClick selector="{{AdminDataGridHeaderSection.clearFilters}}"
+                          dependentSelector="{{AdminDataGridHeaderSection.clearFilters}}" visible="true"
+                          stepKey="assertClearFilters"/>
+        <fillField selector="{{AdminCartPriceRulesSection.filterByNameInput}}"
+                   userInput="{{TestCartPriceRule.name}}" stepKey="assertFilterByName"/>
+        <click selector="{{AdminCartPriceRulesSection.searchButton}}" stepKey="assertSearch"/>
+        <waitForPageLoad stepKey="assertWaitForGrid"/>
+        <seeElement selector="{{AdminCartPriceRulesSection.rowContainingText(TestCartPriceRule.name)}}"
+                    stepKey="assertRuleStillPresentInGrid"/>
+    </test>
