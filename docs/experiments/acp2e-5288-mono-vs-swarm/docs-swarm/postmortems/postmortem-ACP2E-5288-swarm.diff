+use Magento\TestFramework\Helper\Bootstrap;
+use Magento\TestFramework\TestCase\AbstractBackendController;
+
+/**
+ * Reproduces the multi-tab admin race on a Cart Price Rule that carries a scheduled permanent update.
+ *
+ * The rule is scheduled into a permanent update and then a prior request removes it from that update
+ * (both committed, mirroring Tab B's already-finished request). The corrupting step - Tab A saving its
+ * stale snapshot that still references the emptied update - is driven through the REAL admin controller
+ * so the request-bound Hydrator and VersionManager hydrate/version exactly as in production. The rule
+ * must remain visible at the current version and its coupon must not be orphaned.
+ *
+ * @magentoDbIsolation disabled
+ * @magentoAppArea adminhtml
+ * @magentoDataFixture Magento/SalesRule/_files/cart_rule_with_coupon_5_off_no_condition.php
+ */
+class StaleUpdateTabSaveTest extends AbstractBackendController
+{
+    private const APPLIED_VERSION = 1490772480; // Vcur: an already-applied version (> INITIAL)
+    private const FUTURE_UPDATE = 2000000000;   // Uf: permanent future update id (< MAX_VERSION)
+
+    /** @var AdapterInterface */
+    private $connection;
+
+    /** @var int */
+    private $ruleId = 0;
+
+    /** @var int|string|null */
+    private $originalVersionId;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->connection = Bootstrap::getObjectManager()->get(ResourceConnection::class)->getConnection();
+        $this->originalVersionId = Bootstrap::getObjectManager()
+            ->get(VersionHistoryInterface::class)
+            ->getCurrentId();
+    }
+
+    protected function tearDown(): void
+    {
+        $this->cleanupCommittedState();
+        parent::tearDown();
+    }
+
+    /**
+     * Scenario: rule scheduled into a permanent update, then removed from it (both committed); the stale
+     *           tab re-saves the emptied update through the real staging save controller.
+     * Expected: the rule remains visible at the current version and the coupon is not orphaned.
+     */
+    public function testStaleModalSaveAfterRemovalKeepsRuleVisible(): void
+    {
+        $futureRow = $this->prepareRemovedFutureUpdate();
+        $ruleId = $this->ruleId;
+
+        // Tab A: stale modal Save (mode=save) against the now-emptied update Uf, via the real controller.
+        $post = $this->buildStaleRulePost($ruleId, $futureRow);
+        $post['staging'] = [
+            'mode' => 'save',
+            'update_id' => self::FUTURE_UPDATE,
+            'name' => 'Stale tab future update',
+            'start_time' => date('Y-m-d H:i:s', self::FUTURE_UPDATE),
+        ];
+        $this->dispatchPost('backend/salesrulestaging/update/save', $post);
+        $this->dumpRows($ruleId, 'after Tab A stale modal save controller');
+
+        $this->assertRuleStillVisible($ruleId);
+    }
+
+    /**
+     * Scenario: rule scheduled into a permanent update, then removed from it (both committed); the stale
+     *           tab clicks the page main Save while its version pointer still targets the emptied update.
+     * Expected: the rule remains visible at the current version and the coupon is not orphaned.
+     */
+    public function testStaleMainSaveAfterRemovalKeepsRuleVisible(): void
+    {
+        $futureRow = $this->prepareRemovedFutureUpdate();
+        $ruleId = $this->ruleId;
+
+        // Tab A: page main Save while ___version still points at Uf, via the real controller.
+        $post = $this->buildStaleRulePost($ruleId, $futureRow);
+        $this->dispatchPost('backend/sales_rule/promo_quote/save', $post);
+        $this->dumpRows($ruleId, 'after Tab A main save controller');
+
+        $this->assertRuleStillVisible($ruleId);
+    }
+
+    /**
+     * Scenario: the stale tab performs BOTH of its requests in order - the modal Save (which re-schedules
+     *           the rule back into the emptied update) and then the page main Save - the second running
+     *           while the version pointer still targets the future update Uf.
+     * Expected: the rule remains visible at the current version and the coupon is not orphaned.
+     */
+    public function testStaleModalThenMainSaveSequenceKeepsRuleVisible(): void
+    {
+        $futureRow = $this->prepareRemovedFutureUpdate();
+        $ruleId = $this->ruleId;
+        $om = Bootstrap::getObjectManager();
+
+        // Request 1: stale modal Save via the real controller action (mode=save).
+        $modalPost = $this->buildStaleRulePost($ruleId, $futureRow);
+        $modalPost['staging'] = [
+            'mode' => 'save',
+            'update_id' => self::FUTURE_UPDATE,
+            'name' => 'Stale tab future update',
+            'start_time' => date('Y-m-d H:i:s', self::FUTURE_UPDATE),
+        ];
+        $this->executeControllerAction(
+            \Magento\SalesRuleStaging\Controller\Adminhtml\Update\Save::class,
+            $modalPost
+        );
+        $this->dumpRows($ruleId, 'after Tab A request 1 (modal save)');
+
+        // Request 2: page main Save. The stale tab is still positioned on the future version Uf, so the
+        // save runs with the version pointer at Uf (as the future-version edit page would).
+        $om->get(VersionManager::class)->setCurrentVersionId((string)self::FUTURE_UPDATE);
+        $mainPost = $this->buildStaleRulePost($ruleId, $futureRow);
+        $this->executeControllerAction(
+            \Magento\SalesRule\Controller\Adminhtml\Promo\Quote\Save::class,
+            $mainPost
+        );
+        $om->get(VersionManager::class)->setCurrentVersionId((string)self::APPLIED_VERSION);
+        $this->dumpRows($ruleId, 'after Tab A request 2 (main save)');
+
+        $this->assertRuleStillVisible($ruleId);
+    }
+
+    /**
+     * Invoke a real admin controller action directly with the given POST payload (routing bypassed so a
+     * second request can run in-process), preserving the request-bound Hydrator/VersionManager behaviour.
+     *
+     * @param string $actionClass
+     * @param array $post
+     * @return void
+     */
+    private function executeControllerAction(string $actionClass, array $post): void
+    {
+        $request = $this->getRequest();
+        $request->setMethod(Http::METHOD_POST);
+        $request->setPostValue($post);
+        foreach ($post as $key => $value) {
+            $request->setParam($key, $value);
+        }
+        $action = Bootstrap::getObjectManager()->create($actionClass);
+        $result = $action->execute();
+        if ($result instanceof \Magento\Framework\Controller\ResultInterface) {
+            $result->renderResult($this->getResponse());
+        }
+        fwrite(STDERR, "\n[execute $actionClass] body="
+            . substr((string)$this->getResponse()->getBody(), 0, 220) . "\n");
+        $this->getResponse()->clearBody();
+    }
+
+    /**
+     * Scenario: the modal Save errored and was ignored (state stays [Vcur,MAX)); the stale tab then clicks
+     *           the page main Save while still positioned on the future version Uf.
+     * Expected: the rule remains visible at the current version and the coupon is not orphaned.
+     */
+    public function testStaleMainSaveAtFutureVersionAfterRemovalKeepsRuleVisible(): void
+    {
+        $futureRow = $this->prepareRemovedFutureUpdate();
+        $ruleId = $this->ruleId;
+        $om = Bootstrap::getObjectManager();
+
+        // Modal save "errored, ignored": nothing re-created, rule is a single [Vcur,MAX) row. Now the main
+        // save runs with the version pointer still at the future update Uf.
+        $om->get(VersionManager::class)->setCurrentVersionId((string)self::FUTURE_UPDATE);
+        $mainPost = $this->buildStaleRulePost($ruleId, $futureRow);
+        $this->executeControllerAction(
+            \Magento\SalesRule\Controller\Adminhtml\Promo\Quote\Save::class,
+            $mainPost
+        );
+        $om->get(VersionManager::class)->setCurrentVersionId((string)self::APPLIED_VERSION);
+        $this->dumpRows($ruleId, 'after main save at future version');
+
+        $this->assertRuleStillVisible($ruleId);
+    }
+
+    /**
+     * Establish the committed precondition: rule scheduled into permanent update Uf then removed from it.
+     *
+     * @return array the future row snapshot the stale tab would hold (row_id/created_in/updated_in)
+     */
+    private function prepareRemovedFutureUpdate(): array
+    {
+        $om = Bootstrap::getObjectManager();
+        $this->ruleId = (int)$this->connection->fetchOne(
+            "SELECT rule_id FROM salesrule WHERE name = ?",
+            ['cart_rule_with_coupon_5_off_no_condition']
+        );
+        $this->assertNotEmpty($this->ruleId, 'Fixture rule not found.');
+        $ruleId = $this->ruleId;
+
+        /** @var VersionHistoryInterface $versionHistory */
+        $versionHistory = $om->get(VersionHistoryInterface::class);
+        /** @var VersionManager $versionManager */
+        $versionManager = $om->get(VersionManager::class);
+        /** @var Retriever $retriever */
+        $retriever = $om->get(Retriever::class);
+        /** @var EntityStaging $entityStaging */
+        $entityStaging = $om->get(EntityStaging::class);
+
+        // Precondition: an applied update advanced the global staging version past INITIAL.
+        $versionHistory->setCurrentId(self::APPLIED_VERSION);
+        $this->connection->update(
+            'salesrule',
+            ['created_in' => self::APPLIED_VERSION],
+            ['rule_id = ?' => $ruleId]
+        );
+
+        // Create the permanent future update Uf (start only, no end -> permanent).
+        $this->connection->insert('staging_update', [
+            'id' => self::FUTURE_UPDATE,
+            'start_time' => date('Y-m-d H:i:s', self::FUTURE_UPDATE),
+            'name' => 'Stale tab future update',
+            'is_campaign' => 0,
+        ]);
+
+        // Schedule the rule into Uf (splits into rows [Vcur,Uf)+[Uf,MAX)).
+        $versionManager->setCurrentVersionId(self::FUTURE_UPDATE);
+        $rule = $retriever->getEntity($ruleId);
+        $entityStaging->schedule($rule, (string)self::FUTURE_UPDATE, ['copy_origin_in' => self::APPLIED_VERSION]);
+        $versionManager->setCurrentVersionId(self::APPLIED_VERSION);
+        $this->dumpRows($ruleId, 'after schedule into Uf');
+
+        // Snapshot of the FUTURE row the stale tab still holds in its form.
+        $futureRow = $this->connection->fetchRow(
+            "SELECT * FROM salesrule WHERE rule_id = ? AND created_in = ?",
+            [$ruleId, self::FUTURE_UPDATE]
+        );
+        fwrite(STDERR, "\n[Tab A stale snapshot] " . json_encode([
+            'row_id' => $futureRow['row_id'] ?? null,
+            'created_in' => $futureRow['created_in'] ?? null,
+            'updated_in' => $futureRow['updated_in'] ?? null,
+        ]) . "\n");
+
+        // Tab B (already-committed request): remove the rule from update Uf. Row back to [Vcur,MAX).
+        $versionManager->setCurrentVersionId(self::FUTURE_UPDATE);
+        $ruleForRemove = $retriever->getEntity($ruleId);
+        $entityStaging->unschedule($ruleForRemove, (string)self::FUTURE_UPDATE);
+        $versionManager->setCurrentVersionId(self::APPLIED_VERSION);
+        $this->dumpRows($ruleId, 'after Tab B unschedule (committed)');
+
+        return $futureRow ?: [];
+    }
+
+    /**
+     * Assert the ticket invariants: rule visible at current version and coupon not orphaned.
+     *
+     * @param int $ruleId
+     * @return void
+     */
+    private function assertRuleStillVisible(int $ruleId): void
+    {
+        $covering = (int)$this->connection->fetchOne(
+            "SELECT COUNT(*) FROM salesrule WHERE rule_id = ? AND created_in <= ? AND updated_in > ?",
+            [$ruleId, self::APPLIED_VERSION, self::APPLIED_VERSION]
+        );
+        $orphanCoupons = (int)$this->connection->fetchOne(
+            "SELECT COUNT(*) FROM salesrule_coupon c
+             LEFT JOIN salesrule s
+               ON s.rule_id = c.rule_id AND s.created_in <= ? AND s.updated_in > ?
+             WHERE c.rule_id = ? AND s.rule_id IS NULL",
+            [self::APPLIED_VERSION, self::APPLIED_VERSION, $ruleId]
+        );
+        fwrite(STDERR, "\n[RESULT] coveringRows=$covering orphanCoupons=$orphanCoupons\n");
+
+        $this->assertGreaterThan(
+            0,
+            $covering,
+            'Cart Price Rule must remain visible at the current version after a stale-tab save.'
+        );
+        $this->assertSame(
+            0,
+            $orphanCoupons,
+            'Coupon must not be orphaned (must still resolve to a visible rule row).'
+        );
+    }
+
+    /**
+     * Build a stale rule POST payload carrying the future row's link-field (row_id) and created_in=Uf.
+     *
+     * @param int $ruleId
+     * @param array $futureRow
+     * @return array
+     */
+    private function buildStaleRulePost(int $ruleId, array $futureRow): array
+    {
+        return [
+            'rule_id' => $ruleId,
+            'row_id' => $futureRow['row_id'] ?? null,
+            'created_in' => self::FUTURE_UPDATE,
+            VersionManager::PARAM_NAME => self::FUTURE_UPDATE,
+            'name' => 'cart_rule_with_coupon_5_off_no_condition',
+            'is_active' => 1,
+            'website_ids' => [1],
+            'customer_group_ids' => [0, 1, 2, 3],
+            'coupon_type' => Rule::COUPON_TYPE_SPECIFIC,
+            'simple_action' => Rule::CART_FIXED_ACTION,
+            'discount_amount' => 5,
+            'discount_step' => 0,
+            'stop_rules_processing' => 1,
+            'uses_per_customer' => 0,
+            'uses_per_coupon' => 0,
+        ];
+    }
+
+    /**
+     * Dispatch a single admin POST and report route, http code and response body for diagnostics.
+     *
+     * @param string $uri
+     * @param array $post
+     * @return void
+     */
+    private function dispatchPost(string $uri, array $post): void
+    {
+        $request = $this->getRequest();
+        $request->setMethod(Http::METHOD_POST);
+        $request->setPostValue($post);
+        foreach ($post as $key => $value) {
+            $request->setParam($key, $value);
+        }
+        $this->dispatch($uri);
+
+        $response = $this->getResponse();
+        $code = method_exists($response, 'getHttpResponseCode') ? $response->getHttpResponseCode() : 'n/a';
+        fwrite(STDERR, "\n[dispatch $uri] http=$code route="
+            . $request->getModuleName() . '/' . $request->getControllerName() . '/' . $request->getActionName()
+            . " body=" . substr((string)$response->getBody(), 0, 220) . "\n");
+    }
+
+    /**
+     * Dump the salesrule version rows for the given rule to STDERR.
+     *
+     * @param int $ruleId
+     * @param string $label
+     * @return void
+     */
+    private function dumpRows(int $ruleId, string $label): void
+    {
+        $rows = $this->connection->fetchAll(
+            "SELECT row_id, rule_id, created_in, updated_in FROM salesrule WHERE rule_id = ? ORDER BY created_in",
+            [$ruleId]
+        );
+        fwrite(STDERR, "\n[$label] Vcur=" . self::APPLIED_VERSION . " Uf=" . self::FUTURE_UPDATE . "\n");
+        foreach ($rows as $r) {
+            fwrite(STDERR, sprintf(
+                "  row_id=%s rule_id=%s created_in=%s updated_in=%s\n",
+                $r['row_id'],
+                $r['rule_id'],
+                $r['created_in'],
+                $r['updated_in']
+            ));
+        }
+    }
+
+    /**
+     * Remove all committed rows this test created and restore the global staging version pointer.
+     *
+     * @return void
+     */
+    private function cleanupCommittedState(): void
+    {
+        try {
+            $connection = Bootstrap::getObjectManager()->get(ResourceConnection::class)->getConnection();
+            if ($this->ruleId) {
+                $connection->delete('salesrule_coupon', ['rule_id = ?' => $this->ruleId]);
+                $connection->delete('salesrule', ['rule_id = ?' => $this->ruleId]);
+            }
+            $connection->delete('staging_update', ['id = ?' => self::FUTURE_UPDATE]);
+            if ($this->originalVersionId !== null) {
+                Bootstrap::getObjectManager()
+                    ->get(VersionHistoryInterface::class)
+                    ->setCurrentId($this->originalVersionId);
+            }
+        } catch (\Throwable $e) {
+            fwrite(STDERR, "\n[cleanup error] " . $e->getMessage() . "\n");
+        }
+    }
+}
