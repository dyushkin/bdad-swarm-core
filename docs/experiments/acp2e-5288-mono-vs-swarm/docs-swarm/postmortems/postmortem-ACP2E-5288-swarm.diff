+    /**
+     * Ensure the entity is still scheduled in the referenced update before re-saving into it.
+     *
+     * Guards against a stale editing session: if the entity was removed from the update by another
+     * request (e.g. a second browser tab) the persisted version row at created_in = update_id no
+     * longer exists, and re-scheduling into that emptied update would rewrite the surviving row's
+     * version interval against a phantom origin, pushing the entity out of the visible version range.
+     * The persisted state is queried directly because the posted created_in is taken from the stale
+     * form and cannot be trusted.
+     *
+     * @param object $entity
+     * @param int|string $updateId
+     * @return void
+     * @throws LocalizedException
+     */
+    private function assertEntityPresentInUpdate($entity, $updateId): void
+    {
+        if (!$entity instanceof AbstractModel) {
+            return;
+        }
+        try {
+            $entityType = $this->typeResolver->resolve($entity);
+            $metadata = $this->metadataPool->getMetadata($entityType);
+        } catch (\Exception $e) {
+            return;
+        }
+        $identifierField = $metadata->getIdentifierField();
+        $identifier = $entity->getData($identifierField);
+        if (empty($identifier)) {
+            return;
+        }
+        $connection = $metadata->getEntityConnection();
+        $select = $connection->select()
+            ->from($metadata->getEntityTable(), $identifierField)
+            ->where($identifierField . ' = ?', $identifier)
+            ->where('created_in = ?', $updateId)
+            ->setPart('disable_staging_preview', true)
+            ->limit(1);
+        if (!$connection->fetchOne($select)) {
+            throw new LocalizedException(
+                __(
+                    'This scheduled update no longer contains the item you are trying to save. '
+                    . 'It may have been changed in another session. Please reload the page and try again.'
+                )
+            );
+        }
+    }
+
