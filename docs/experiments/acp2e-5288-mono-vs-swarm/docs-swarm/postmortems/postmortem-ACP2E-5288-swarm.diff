+        <waitForPageLoad stepKey="tabAAfterCloseSlideOut"/>
+        <click selector="{{AdminCartPriceRulesFormSection.save}}" stepKey="tabAMainSave"/>
+        <waitForPageLoad stepKey="tabAAfterMainSave"/>
