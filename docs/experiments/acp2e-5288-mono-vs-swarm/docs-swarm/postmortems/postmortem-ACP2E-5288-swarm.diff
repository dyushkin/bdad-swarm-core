+<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
+    <test name="AdminStaleTabScheduledUpdateKeepsCartPriceRuleAvailableTest">
+        <annotations>
+            <features value="StagingAndPreview"/>
+            <stories value="Cart Price Rule remains available after a stale-tab scheduled update save race"/>
+            <title value="Cart Price Rule with a coupon survives a two-tab scheduled-update deletion race"/>
+            <description value="A cart price rule with a specific coupon and a scheduled permanent update must
+                remain in the grid after a second tab deletes that update and the first, stale tab saves the
+                already-removed scheduled change followed by the main rule save."/>
+            <severity value="CRITICAL"/>
+            <group value="staging"/>
+        </annotations>
+        <before>
+            <!-- Login as admin -->
+            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
+            <!-- Precondition: advance the global staging version through an applied update. -->
+            <!-- Without an advanced version the new rule stays at the INITIAL version and the race is inert. -->
+            <actionGroup ref="AdminCreateCartPriceRuleWithCouponUsingGroupsWidgetActionGroup"
+                         stepKey="createPreconditionRule">
+                <argument name="ruleName" value="CatPriceRule"/>
+                <argument name="couponCode" value="{{CatPriceRule.coupon_code}}"/>
+            </actionGroup>
+            <actionGroup ref="AdminOpenCartPriceRulesPageActionGroup" stepKey="openGridForPrecondition"/>
+            <actionGroup ref="AdminFilterCartPriceRuleActionGroup" stepKey="filterPreconditionRule">
+                <argument name="ruleName" value="CatPriceRule.name"/>
+            </actionGroup>
+            <!-- Schedule a near-future update so cron can apply it and move the version forward. -->
+            <generateDate date="+1 minute" format="m/j/Y g:i A" stepKey="generatePreconditionStart"/>
+            <click selector="{{AdminStagingSlideOutSection.scheduleNewUpdateBtn}}" stepKey="clickScheduleNewUpdatePre"/>
+            <waitForElementVisible selector="{{AdminStagingSlideOutSection.updateName}}" stepKey="waitUpdateNamePre"/>
+            <fillField selector="{{AdminStagingSlideOutSection.updateName}}"
+                       userInput="{{PreconditionAppliedUpdate.updateName}}" stepKey="fillUpdateNamePre"/>
+            <fillField selector="{{AdminStagingSlideOutSection.updateDescription}}"
+                       userInput="{{PreconditionAppliedUpdate.updateDescription}}" stepKey="fillDescPre"/>
+            <fillField selector="{{AdminStagingSlideOutSection.startDate}}"
+                       userInput="{$generatePreconditionStart}" stepKey="fillStartPre"/>
+            <click selector="{{AdminStagingSlideOutSection.save}}" stepKey="savePreUpdate"/>
+            <waitForPageLoad time="30" stepKey="waitAfterSavePre"/>
+            <!-- Let the update's start time pass, then apply it with the staging cron group. -->
+            <wait time="75" stepKey="waitForPreconditionUpdateStart"/>
+            <magentoCLI command="cron:run" arguments="--group staging" stepKey="cronRunPre1"/>
+            <magentoCLI command="cron:run" arguments="--group staging" stepKey="cronRunPre2"/>
+        </before>
+        <after>
+            <!-- Remove every cart price rule (and its coupons/updates) created by the test via the API. -->
+            <helper class="Magento\SalesRule\Test\Mftf\Helper\SalesRuleApiHelper"
+                    method="deleteAllSalesRulesApi" stepKey="deleteAllRulesViaApi"/>
+            <!-- Log out so the session is clean (runs on whichever tab is active). -->
+            <actionGroup ref="AdminLogoutActionGroup" stepKey="logout"/>
+        </after>
+
+        <!-- Step 1a: create a new cart price rule with a specific coupon code. -->
+        <actionGroup ref="AdminCreateCartPriceRuleWithCouponUsingGroupsWidgetActionGroup"
+                     stepKey="createRuleWithCoupon">
+            <argument name="ruleName" value="TestCartPriceRule"/>
+            <argument name="couponCode" value="{{_defaultCoupon.code}}"/>
+        </actionGroup>
+
+        <!-- Step 1b: schedule a permanent (no end date) far-future update for that rule. -->
+        <actionGroup ref="CreateSalesRulePermanentUpdateActionGroup" stepKey="schedulePermanentUpdate">
+            <argument name="ruleName" value="TestCartPriceRule"/>
+            <argument name="schedule" value="StaleTabPermanentUpdate"/>
+        </actionGroup>
+
+        <!-- Step 2 (Tab A): open the scheduled change into the modal and leave it open. -->
+        <actionGroup ref="AdminOpenCartPriceRulesPageActionGroup" stepKey="tabAOpenGrid"/>
+        <actionGroup ref="AdminFilterCartPriceRuleActionGroup" stepKey="tabAFilter">
+            <argument name="ruleName" value="TestCartPriceRule.name"/>
+        </actionGroup>
+        <click selector="{{AdminScheduledChangesSection.scheduleViewEdit(StaleTabPermanentUpdate.updateName)}}"
+               stepKey="tabAOpenModal"/>
+        <waitForElementVisible selector="{{AdminStagingSlideOutSection.title}}" stepKey="tabAModalVisible"/>
+        <waitForPageLoad stepKey="tabAModalLoaded"/>
+
+        <!-- Step 3 (Tab B): open a second tab on the same rule's edit page. -->
+        <openNewTab stepKey="openTabB"/>
+        <actionGroup ref="AdminOpenCartPriceRulesPageActionGroup" stepKey="tabBOpenGrid"/>
+        <actionGroup ref="AdminFilterCartPriceRuleActionGroup" stepKey="tabBFilter">
+            <argument name="ruleName" value="TestCartPriceRule.name"/>
+        </actionGroup>
+
+        <!-- Step 4 (Tab B): remove the scheduled change from the update, delete the update, then main-save. -->
+        <actionGroup ref="DeleteTheUpdateActionGroup" stepKey="tabBDeleteUpdate">
+            <argument name="fromStaging" value="StaleTabPermanentUpdate"/>
+            <argument name="slideOutHeadingTitle" value="Remove Cart Price Rule from Update"/>
+            <argument name="warningMessageType" value="cart price rule"/>
+        </actionGroup>
+        <click selector="{{AdminCartPriceRulesFormSection.save}}" stepKey="tabBMainSave"/>
+        <waitForElementVisible selector="{{AdminMessagesSection.success}}" stepKey="tabBWaitSaveSuccess"/>
+
+        <!-- Step 5 (Tab A): the modal still shows the now-removed schedule. Save it inside the modal. -->
+        <!-- With the corruption guard in place the stale save is rejected server-side: the slide-out -->
+        <!-- shows an error and stays open. Per the ticket the error is ignored; dismiss the slide-out, -->
+        <!-- then perform the stale main save that used to delete the rule. -->
+        <switchToPreviousTab stepKey="switchBackToTabA"/>
+        <click selector="{{AdminStagingSlideOutSection.save}}" stepKey="tabAModalSave"/>
+        <waitForPageLoad stepKey="tabAAfterModalSave"/>
+        <!-- Observe (but do not assert the exact text of) the rejection error, then close the slide-out. -->
